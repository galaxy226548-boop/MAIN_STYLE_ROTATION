        {
          "function_target": "趋势方向A",
          "function_template": "ma_spread_rank",
          "fake_code": "def factor_ma_spread_rank(sub_1, params):\n    short_window = params.get(\"short_window\", 20)\n    long_window = params.get(\"long_window\", 120)\n    rank_window = params.get(\"rank_window\", 756)\n    center = params.get(\"center\", 0.5)\n    direction = params.get(\"direction\", -1)\n\n    short_ma = sub_1.rolling(short_window).mean()\n    long_ma = sub_1.rolling(long_window).mean()\n    spread = short_ma - long_ma\n\n    rank = rolling_quantile_rank(spread, window=rank_window)\n    factor = direction * (rank - center)\n    return factor",
          "notes": "short_ma - long_ma 越高，说明利率上行趋势越强。\ndirection = -1 时：\n利率上行趋势强 → factor 为负 → 推荐价值\n利率下行趋势强 → factor 为正 → 推荐成长"
