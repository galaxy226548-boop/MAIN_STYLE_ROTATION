        {
          "function_target": "趋势方向B",
          "function_template": "ols_slope_rank",
          "fake_code": "def rolling_ols_slope(series, window):\n    import numpy as np\n\n    def ols_slope(y):\n        x = np.arange(len(y))\n        return np.polyfit(x, y, 1)[0]\n\n    return series.rolling(window).apply(ols_slope, raw=True)\n\n\ndef factor_ols_slope_rank(sub_1, params):\n    slope_window = params.get(\"slope_window\", 60)\n    rank_window = params.get(\"rank_window\", 756)\n    center = params.get(\"center\", 0.5)\n    direction = params.get(\"direction\", -1)\n\n    slope_series = rolling_ols_slope(sub_1, window=slope_window)\n    rank = rolling_quantile_rank(slope_series, window=rank_window)\n    factor = direction * (rank - center)\n    return factor",
          "notes": "direction=-1时，OLS斜率高 → 利率上行趋势强 → 贴现率上行压力强 → 成长估值受压 → 因子应偏价值\nOLS斜率低 → 利率下行趋势强 → 贴现率下行压力强 → 成长估值受益 → 因子应偏成长"
